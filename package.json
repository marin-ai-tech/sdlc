{
  "name": "sdlc",
  "version": "0.11.1",
  "description": "AI-native SDLC harness for Claude Code and OpenCode, built on OpenSpec",
  "keywords": [
    "sdlc",
    "openspec",
    "claude-code",
    "opencode",
    "spec-driven",
    "ai-native",
    "agents"
  ],
  "homepage": "https://github.com/marin-ai-tech/sdlc",
  "repository": {
    "type": "git",
    "url": "https://github.com/marin-ai-tech/sdlc"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "marin-ai technologies (https://github.com/marin-ai-tech)",
  "type": "module",
  "bin": {
    "sdlc": "./bin/sdlc.js",
    "scdl": "./bin/scdl.js"
  },
  "files": [
    "dist",
    "bin",
    "schemas",
    "assets",
    "LICENSE",
    "LICENSES",
    "NOTICE.md",
    "COMMERCIAL-LICENSE.md"
  ],
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepare": "tsc -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:deck": "tsc -p tsconfig.json && node scripts/demo/build-all.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@fission-ai/openspec": "^1.13.2",
    "@inquirer/prompts": "^8.7.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.0",
    "picomatch": "^4.0.2",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/picomatch": "^4.0.0",
    "pptxgenjs": "^3.12.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
