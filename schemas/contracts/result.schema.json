{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlc.dev/schemas/contracts/result.schema.json",
  "title": "sdlc task check-result verdict",
  "description": "Result verdict. Missing local branches are fetched from origin into a unique internal ref.",
  "type": "object",
  "required": ["ok", "base", "commits", "files", "problems", "warnings"],
  "properties": {
    "ok": { "type": "boolean" },
    "base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "The commit the range <base>..<branch> was computed from"
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sha", "subject"],
        "properties": {
          "sha": { "type": "string" },
          "subject": { "type": "string" },
          "change": { "type": "string", "description": "SDLC-Change trailer, when present" },
          "task": { "type": "string", "description": "SDLC-Task trailer, when present" },
          "agent": { "type": "string", "description": "SDLC-Agent trailer value `<executor>/<agent>`, when present" }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "Changed files of the range: repo-relative, POSIX separators, sorted"
    },
    "problems": {
      "type": "array",
      "description": "Failures: ok=false and exit code 1 when non-empty",
      "items": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": { "enum": ["missing_trailer", "unknown_task", "forbidden_path", "no_commits", "missing_agent", "unknown_executor", "executor_not_allowed", "wrong_executor"] },
          "sha": { "type": "string" },
          "file": { "type": "string" },
          "task": { "type": "string" },
          "executor": { "type": "string", "description": "Executor id the SDLC-Agent trailer names (agent problems)" }
        },
        "additionalProperties": false
      }
    },
    "executors": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
      "uniqueItems": true,
      "description": "Distinct executor ids the commits' SDLC-Agent trailers name, sorted; only with a registry"
    },
    "warnings": {
      "type": "array",
      "description": "Non-fatal findings: ok stays true and exit code stays 0",
      "items": {
        "type": "object",
        "required": ["code", "file"],
        "properties": {
          "code": { "const": "outside_plan" },
          "file": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
